# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# DTOs are (de)serialized by kotlinx.serialization through Retrofit.
-keep class com.example.pruebatecnica.data.remote.dto.** { *; }

# Retrofit service interface (methods are read via reflection).
-keep interface com.example.pruebatecnica.data.remote.RickAndMortyApi { *; }
